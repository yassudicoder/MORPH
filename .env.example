# Copy this file to .env and change what you need. Every option is free.

# Which LLM compiles the operator's sentence into a mission:
#   ollama     - local model on your laptop, works offline (default)
#   lmstudio   - local model through LM Studio
#   groq       - free cloud tier (needs GROQ_API_KEY from console.groq.com)
#   gemini     - free cloud tier (needs GEMINI_API_KEY from aistudio.google.com)
#   openrouter - free models (needs OPENROUTER_API_KEY, and a ":free" model name)
#   rules      - no LLM at all: TOWER's keyword compiler (instant, always works)
TOWER_LLM_PROVIDER=ollama

# Leave empty to auto-pick an installed Ollama model. Good small choices:
#   ollama pull qwen2.5:3b     (2 GB, fast on CPU)
#   ollama pull qwen2.5:7b     (4.7 GB, more reliable JSON)
TOWER_LLM_MODEL=

# Only for cloud providers. Never commit real keys.
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# 1 = let the LLM rewrite decision explanations in the background (template text is used otherwise)
TOWER_LLM_EXPLAIN=0

# Seconds the operator has to answer an ASK before the default (or a safe hold) runs
TOWER_ASK_TIMEOUT=60

# Same seed = same detections and noise = the demo plays the same way twice
TOWER_SEED=7

# Set this before putting TOWER online: visitors watch, only links with ?key=<this> can control
# TOWER_ACCESS_KEY=pick-a-long-random-word
